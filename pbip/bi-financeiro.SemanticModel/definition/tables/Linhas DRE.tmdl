				        {6, "(−) Despesas comerciais", "Grupo"},
				        {7, "(−) Despesas administrativas", "Grupo"},
				        {8, "(−) Logística", "Grupo"},
				        {9, "(=) EBITDA", "Subtotal"},
				        {10, "(−) Depreciação", "Grupo"},
				        {11, "(±) Resultado financeiro", "Grupo"},
				        {12, "(=) Lucro antes do IR", "Subtotal"},
				        {13, "(−) IR/CSLL", "Grupo"},
				        {14, "(=) Lucro líquido", "Subtotal"}
				    }
				)

