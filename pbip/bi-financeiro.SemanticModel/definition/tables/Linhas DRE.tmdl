/// Linhas da matriz da DRE. Grupo: casa com Plano de contas pela Ordem DRE. Subtotal: soma dos grupos acima.
table 'Linhas DRE'
	lineageTag: c3d67926-300a-4721-a4d3-8f3f20c9cd83

	column Ordem
