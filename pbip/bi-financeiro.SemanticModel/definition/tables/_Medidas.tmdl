/// Tabela só para guardar as medidas.
table _Medidas
	lineageTag: 8dd6d647-d2c5-4461-82f6-be7fb2d699c7

	/// Soma dos lançamentos com sinal (receita +, custos e despesas −). Base de toda a DRE.
	measure Resultado = SUM('Lançamentos'[Valor])
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: 84460848-b8f2-41fc-ac1a-0c5a982eac26

	measure 'Receita bruta' = CALCULATE([Resultado], 'Plano de contas'[Ordem DRE] = 1)
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: ae7f9466-d454-43be-880a-6d54b60c9ad8

	/// Subtotal: soma dos grupos que vêm antes na DRE (os valores já têm sinal).
	measure 'Receita líquida' = CALCULATE([Resultado], 'Plano de contas'[Ordem DRE] < 3)
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: 3effad2a-b685-47d4-8852-c70abba27554

	measure 'Lucro bruto' = CALCULATE([Resultado], 'Plano de contas'[Ordem DRE] < 5)
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: 4087bcdc-4895-4bd8-8f30-1afb21b9f934

	measure EBITDA = CALCULATE([Resultado], 'Plano de contas'[Ordem DRE] < 9)
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: dde26bcb-fddc-4313-811c-fc38613fc1c4

	measure 'Lucro líquido' = CALCULATE([Resultado], 'Plano de contas'[Ordem DRE] < 14)
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: 10851d5a-3281-4b1f-a9b4-dc5f28356a0f

	measure '% Margem bruta' = DIVIDE([Lucro bruto], [Receita líquida])
		formatString: 0.0%
		displayFolder: Resultado
		lineageTag: 9a542fa4-24d8-49e8-92f4-cb415d46e518

	measure '% Margem EBITDA' = DIVIDE([EBITDA], [Receita líquida])
		formatString: 0.0%
		displayFolder: Resultado
		lineageTag: cc21bf04-0160-4bf2-911c-2676e185ef25

	measure '% Margem líquida' = DIVIDE([Lucro líquido], [Receita líquida])
		formatString: 0.0%
		displayFolder: Resultado
		lineageTag: 78bf9317-26c7-4914-a9ca-9185c9d5af5b

	/// Valor de cada linha da matriz da DRE: grupo = contas daquele grupo; subtotal = todos os grupos acima dele.
	measure 'Valor DRE' =
			VAR _ordem = SELECTEDVALUE('Linhas DRE'[Ordem])
			RETURN
			    SWITCH(
			        SELECTEDVALUE('Linhas DRE'[Tipo]),
			        "Grupo", CALCULATE([Resultado], 'Plano de contas'[Ordem DRE] = _ordem),
			        "Subtotal", CALCULATE([Resultado], 'Plano de contas'[Ordem DRE] < _ordem)
			    )
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: 561433e5-fba1-4ea4-a0a1-d18923562325

	/// Análise vertical: cada linha da DRE sobre a receita líquida.
	measure '% da receita líquida' = DIVIDE([Valor DRE], [Receita líquida])
		formatString: 0.0%
		displayFolder: Resultado
		lineageTag: 23bb1ae5-971d-4038-bab9-01e6933519e8

	measure 'Receita líquida ano anterior' = CALCULATE([Receita líquida], SAMEPERIODLASTYEAR('Calendário'[Data]))
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: 2787297f-bcdc-44cb-b757-b211cd293937

	measure '% Var. receita a/a' = DIVIDE([Receita líquida] - [Receita líquida ano anterior], [Receita líquida ano anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Resultado
		lineageTag: 19c62f69-9ba5-4fd7-ad01-c8ebf7c1a6df

	measure 'Receita líquida YTD' = TOTALYTD([Receita líquida], 'Calendário'[Data])
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: 8036b380-629e-470a-9f4b-1ffa85cc777c

	/// Receita dos 12 meses que terminam no último dia do contexto (tira a sazonalidade da série).
	measure 'Receita líquida 12m' = CALCULATE([Receita líquida], DATESINPERIOD('Calendário'[Data], MAX('Calendário'[Data]), -12, MONTH))
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: 601585bb-af88-47f6-bc3e-9c34b34b0b8b

	measure 'Lucro líquido ano anterior' = CALCULATE([Lucro líquido], SAMEPERIODLASTYEAR('Calendário'[Data]))
		formatString: "R$" #,0
		displayFolder: Resultado
		lineageTag: b1187a87-672d-405b-be91-10235e45e973

	measure '% Var. lucro a/a' = DIVIDE([Lucro líquido] - [Lucro líquido ano anterior], ABS([Lucro líquido ano anterior]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Resultado
		lineageTag: d7636b37-e446-4563-88a7-26e627eb3019

	measure Orçado = SUM('Orçamento'[Valor orçado])
		formatString: "R$" #,0
		displayFolder: Orçamento
		lineageTag: 07439ebd-9a92-4678-9255-5f2dd8dd8d38

	/// Mesma lógica de Valor DRE, sobre o orçamento.
	measure 'Orçado DRE' =
			VAR _ordem = SELECTEDVALUE('Linhas DRE'[Ordem])
			RETURN
			    SWITCH(
			        SELECTEDVALUE('Linhas DRE'[Tipo]),
			        "Grupo", CALCULATE([Orçado], 'Plano de contas'[Ordem DRE] = _ordem),
			        "Subtotal", CALCULATE([Orçado], 'Plano de contas'[Ordem DRE] < _ordem)
			    )
		formatString: "R$" #,0
		displayFolder: Orçamento
		lineageTag: caab6fc7-cc9f-4be8-be9e-7b5a298a2397

	/// Realizado ÷ orçado. Para despesas, acima de 100% é estouro.
	measure 'Realizado x orçado %' = DIVIDE([Valor DRE], [Orçado DRE])
		formatString: 0%
		displayFolder: Orçamento
		lineageTag: b43af1c2-68f7-4171-9979-ea708c0278ed

	/// Positivo = melhor que o orçado em qualquer linha (os valores têm sinal).
	measure 'Var. vs orçado' = [Valor DRE] - [Orçado DRE]
		formatString: "R$" #,0
		displayFolder: Orçamento
		lineageTag: ca342203-2194-4c59-9a03-6518dfa14143

	measure 'Saldo inicial' = SUM('Saldo inicial'[Saldo])
		formatString: "R$" #,0
		displayFolder: Caixa
		lineageTag: eb201c4e-87ff-484c-ba25-8e5bb33dfd55

	/// Recebimentos pela data de baixa (perdas entram com 0). O filtro Calendário deixa de fora as baixas de 2022.
	measure Entradas =
			CALCULATE(
			    SUM('Títulos a receber'[Valor recebido]),
			    USERELATIONSHIP('Títulos a receber'[Data recebimento], 'Calendário'[Data]),
			    'Calendário'
			)
		formatString: "R$" #,0
		displayFolder: Caixa
		lineageTag: d841e6df-5950-4fb8-a92e-ea5adbb08ec1

	/// Pagamentos pela data de baixa, inclusive juros e distribuição de lucros aos sócios.
	measure Saídas =
			CALCULATE(
			    SUM('Títulos a pagar'[Valor]),
			    USERELATIONSHIP('Títulos a pagar'[Data pagamento], 'Calendário'[Data]),
			    'Calendário'
			)
		formatString: "R$" #,0
		displayFolder: Caixa
		lineageTag: da038d87-af44-431a-a9a2-0a07b994a2e9

	measure 'Geração de caixa' = [Entradas] - [Saídas]
		formatString: "R$" #,0
		displayFolder: Caixa
		lineageTag: cc795dd2-e5a9-4658-9efa-fe60ff133810

	/// Saldo inicial + tudo o que entrou e saiu até o último dia do contexto.
	measure 'Saldo de caixa' =
			VAR _ref = MAX('Calendário'[Data])
			RETURN
			    IF(
			        NOT ISBLANK(_ref),
			        [Saldo inicial]
			            + CALCULATE([Geração de caixa], REMOVEFILTERS('Calendário'), 'Calendário'[Data] <= _ref)
			    )
		formatString: "R$" #,0
		displayFolder: Caixa
		lineageTag: 36749ff6-421a-4671-8c24-ac08a8eede2e

	/// "Hoje" do relatório: último dia do período filtrado. Nunca TODAY(): os dados vão só até 2025.
	measure 'Data de referência' = MAX('Calendário'[Data])
		formatString: dd/mm/yyyy
		displayFolder: Capital de giro
		lineageTag: 726a08ea-64ad-49a2-80a2-81489608b577

	/// Títulos emitidos até a data de referência e ainda não baixados nela (nem recebidos nem perdidos).
	measure 'A receber' =
			VAR _ref = [Data de referência]
			RETURN
			    CALCULATE(
			        SUM('Títulos a receber'[Valor]),
			        REMOVEFILTERS('Calendário'),
			        'Títulos a receber'[Data emissão] <= _ref,
			        'Títulos a receber'[Data recebimento] > _ref || ISBLANK('Títulos a receber'[Data recebimento])
			    )
		formatString: "R$" #,0
		displayFolder: Capital de giro
		lineageTag: e9980f7c-ad45-47e7-b36d-4b892273245f

	measure 'Vendas 90 dias' =
			VAR _ref = [Data de referência]
			RETURN
			    CALCULATE(
			        SUM('Títulos a receber'[Valor]),
			        REMOVEFILTERS('Calendário'),
			        'Títulos a receber'[Data emissão] > _ref - 90,
			        'Títulos a receber'[Data emissão] <= _ref
			    )
		formatString: "R$" #,0
		displayFolder: Capital de giro
		lineageTag: 7e58d401-a7db-471c-a123-e4e4e4ddb928

	/// Prazo médio de recebimento: quantos dias de venda estão a receber.
	measure PMR = DIVIDE([A receber], [Vendas 90 dias]) * 90
		formatString: 0
		displayFolder: Capital de giro
		lineageTag: ac6ccc17-60ab-4241-aeed-7115ca061bf8

	/// Só fornecedores de mercadoria: despesas, impostos e sócios não entram no PMP.
	measure 'A pagar a fornecedores' =
			VAR _ref = [Data de referência]
			RETURN
			    CALCULATE(
			        SUM('Títulos a pagar'[Valor]),
			        REMOVEFILTERS('Calendário'),
			        Fornecedores[Categoria] = "Mercadorias",
			        'Títulos a pagar'[Data emissão] <= _ref,
			        'Títulos a pagar'[Data pagamento] > _ref || ISBLANK('Títulos a pagar'[Data pagamento])
			    )
		formatString: "R$" #,0
		displayFolder: Capital de giro
		lineageTag: b68de0f1-71cd-4a7d-8f2f-bda1069f95bc

	measure 'Compras 90 dias' =
			VAR _ref = [Data de referência]
			RETURN
			    CALCULATE(
			        SUM('Títulos a pagar'[Valor]),
			        REMOVEFILTERS('Calendário'),
			        Fornecedores[Categoria] = "Mercadorias",
			        'Títulos a pagar'[Data emissão] > _ref - 90,
			        'Títulos a pagar'[Data emissão] <= _ref
			    )
		formatString: "R$" #,0
		displayFolder: Capital de giro
		lineageTag: 4d581501-9935-41c6-b003-82911fc428b4

	/// Prazo médio de pagamento a fornecedores de mercadoria.
	measure PMP = DIVIDE([A pagar a fornecedores], [Compras 90 dias]) * 90
		formatString: 0
		displayFolder: Capital de giro
		lineageTag: 97b3da1b-61e4-4be6-80f6-a2eadc3a6f83

	/// Dias que a empresa financia o cliente com dinheiro próprio (sem estoque no modelo: PMR − PMP).
	measure 'Ciclo financeiro' = [PMR] - [PMP]
		formatString: 0
		displayFolder: Capital de giro
		lineageTag: aa70a8ce-f1db-44bb-b691-292b25741947

	measure 'Vencido 90+' =
			VAR _ref = [Data de referência]
			RETURN CALCULATE([A receber], 'Títulos a receber'[Data vencimento] < _ref - 90)
		formatString: "R$" #,0
		displayFolder: Capital de giro
		lineageTag: 419902ac-f818-48ed-8fef-5595280f05a3

	measure '% Inadimplência 90+' = DIVIDE([Vencido 90+], [A receber])
		formatString: 0.0%
		displayFolder: Capital de giro
		lineageTag: cdac2365-a6df-4d92-8487-97e3f96794c2

	/// Aging: saldo a receber cujos dias de atraso caem na faixa (tabela Faixas de aging, desconectada).
	measure 'A receber por faixa' =
			VAR _ref = [Data de referência]
			VAR _de = MIN('Faixas de aging'[Dias de])
			VAR _ate = MAX('Faixas de aging'[Dias até])
			RETURN
			    CALCULATE(
			        [A receber],
			        'Títulos a receber'[Data vencimento] >= _ref - _ate,
			        'Títulos a receber'[Data vencimento] <= _ref - _de
			    )
		formatString: "R$" #,0
		displayFolder: Capital de giro
		lineageTag: 549d869d-8eb3-4ac8-82aa-00a574c4ffe1

	measure '% Margem EBITDA ano anterior' = CALCULATE([% Margem EBITDA], SAMEPERIODLASTYEAR('Calendário'[Data]))
		formatString: 0.0%
		displayFolder: Resultado
		lineageTag: c7da047b-5361-4a32-aad4-e3592362f12f

	measure '% Margem líquida ano anterior' = CALCULATE([% Margem líquida], SAMEPERIODLASTYEAR('Calendário'[Data]))
		formatString: 0.0%
		displayFolder: Resultado
		lineageTag: f4258b86-129b-4e83-a95a-4cd453d5bd64

	/// Valor DRE em milhares, para a matriz.
	measure 'Valor DRE (R$ mil)' = DIVIDE([Valor DRE], 1000)
		formatString: #,0
		displayFolder: Resultado
		lineageTag: adcd577f-ec4a-4c33-a6ac-e21b7b1ed4a2

	/// Formatação condicional da matriz (fonte): subtotais em âmbar.
	measure 'Cor fonte DRE' = IF(SELECTEDVALUE('Linhas DRE'[Tipo]) = "Subtotal", "#FBBF24", "#FFFFFF")
		displayFolder: Resultado
		lineageTag: f976e6e4-c922-4dd6-a158-78e02ef5c798

	/// Distribuição de lucros paga no período: sai do caixa, mas não é despesa.
	measure 'Retirada dos sócios' = CALCULATE([Saídas], Fornecedores[Categoria] = "Sócios")
		formatString: "R$" #,0
		displayFolder: Caixa
		lineageTag: 90342c78-1a33-4e95-919c-f265e5e85e51

	measure 'PMR ano anterior' = CALCULATE([PMR], DATEADD('Calendário'[Data], -1, YEAR))
		formatString: 0
		displayFolder: Capital de giro
		lineageTag: ad774148-2523-4751-8797-02706c112e53

	/// Cartão HTML (visual HTML Content): rótulo, valor e contexto.
	measure 'Card Receita líquida' =
			VAR _v = [Receita líquida]
			VAR _var = [% Var. receita a/a]
			VAR _valor = IF(ISBLANK(_v), "–", "R$ " & FORMAT(_v / 1000000, "#,0.00", "pt-BR") & " mi")
			VAR _sub = IF(ISBLANK(_var), "sem ano anterior para comparar", IF(_var >= 0, "▲ ", "▼ ") & FORMAT(ABS(_var), "0.0%", "pt-BR") & " vs ano anterior")
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>RECEITA LÍQUIDA</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 3da4047e-2af3-4a71-a71b-f7079720e306

	/// Cartão HTML (visual HTML Content): rótulo, valor e contexto.
	measure 'Card Margem bruta' =
			VAR _m = [% Margem bruta]
			VAR _valor = IF(ISBLANK(_m), "–", FORMAT(_m, "0.0%", "pt-BR"))
			VAR _sub = "lucro bruto de R$ " & FORMAT([Lucro bruto] / 1000000, "#,0.00", "pt-BR") & " mi"
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>MARGEM BRUTA</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 57797fc9-df36-4b22-8907-4097cccaf548

	/// Cartão HTML (visual HTML Content): rótulo, valor e contexto.
	measure 'Card EBITDA' =
			VAR _v = [EBITDA]
			VAR _m = [% Margem EBITDA]
			VAR _ant = [% Margem EBITDA ano anterior]
			VAR _pp = (_m - _ant) * 100
			VAR _valor = IF(ISBLANK(_v), "–", IF(_v < 0, "−", "") & "R$ " & FORMAT(ABS(_v) / 1000000, "#,0.00", "pt-BR") & " mi")
			VAR _sub = "margem de " & FORMAT(_m, "0.0%", "pt-BR") & IF(ISBLANK(_ant), "", " (" & IF(_pp >= 0, "▲ ", "▼ ") & FORMAT(ABS(_pp), "0.0", "pt-BR") & " p.p. a/a)")
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>EBITDA</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 220e1e3c-7141-42b5-a65b-fea809de335d

	/// Cartão HTML (visual HTML Content). Valor em vermelho-claro quando sai mais do que entra.
	measure 'Card Geração de caixa' =
			VAR _v = [Geração de caixa]
			VAR _valor = IF(ISBLANK(_v), "–", IF(_v < 0, "−", "") & "R$ " & FORMAT(ABS(_v) / 1000000, "#,0.00", "pt-BR") & " mi")
			VAR _cor = IF(_v < 0, "#F87171", "#FFFFFF")
			VAR _sub = "entrou R$ " & FORMAT([Entradas] / 1000000, "#,0.0", "pt-BR") & " mi, saiu R$ " & FORMAT([Saídas] / 1000000, "#,0.0", "pt-BR") & " mi"
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>GERAÇÃO DE CAIXA</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15;color:" & _cor & "'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 998b63cb-598a-4d98-a753-84d08fa6a293

	/// Cartão HTML (visual HTML Content): o lucro do mesmo período, comparado à geração de caixa.
	measure 'Card Lucro x caixa' =
			VAR _v = [Lucro líquido]
			VAR _dif = _v - [Geração de caixa]
			VAR _valor = IF(ISBLANK(_v), "–", IF(_v < 0, "−", "") & "R$ " & FORMAT(ABS(_v) / 1000000, "#,0.00", "pt-BR") & " mi")
			VAR _sub = "R$ " & FORMAT(ABS(_dif) / 1000000, "#,0.00", "pt-BR") & " mi " & IF(_dif >= 0, "acima", "abaixo") & " da geração de caixa"
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>LUCRO LÍQUIDO</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 2f63edbf-7391-4e1c-ba9a-cc081ac6852a

	/// Cartão HTML (visual HTML Content): rótulo, valor e contexto.
	measure 'Card Retirada dos sócios' =
			VAR _v = [Retirada dos sócios]
			VAR _valor = IF(ISBLANK(_v), "–", "R$ " & FORMAT(_v / 1000000, "#,0.00", "pt-BR") & " mi")
			VAR _sub = FORMAT(DIVIDE(_v, [Lucro líquido]), "0%", "pt-BR") & " do lucro líquido do período"
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>RETIRADA DOS SÓCIOS</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 7ac7bc2d-2715-46ad-8fd1-4d57b876a92a

	/// Cartão HTML (visual HTML Content): rótulo, valor e contexto.
	measure 'Card PMR' =
			VAR _v = [PMR]
			VAR _ant = [PMR ano anterior]
			VAR _dif = ROUND(_v, 0) - ROUND(_ant, 0)
			VAR _valor = IF(ISBLANK(_v), "–", FORMAT(_v, "0", "pt-BR") & " dias")
			VAR _sub = IF(ISBLANK(_ant), "prazo médio de recebimento", IF(_dif >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dif), "0", "pt-BR") & " dias vs ano anterior")
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>PMR · PRAZO DE RECEBIMENTO</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: dbb8d1e7-4174-4ec8-b995-21e975f4ce55

	/// Cartão HTML (visual HTML Content): rótulo, valor e contexto.
	measure 'Card PMP' =
			VAR _v = [PMP]
			VAR _valor = IF(ISBLANK(_v), "–", FORMAT(_v, "0", "pt-BR") & " dias")
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>PMP · PRAZO DE PAGAMENTO</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>fornecedores de mercadoria</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 54c1f3e3-8c7c-4aaf-b09a-a28504d562f7

	/// Cartão HTML (visual HTML Content): rótulo, valor e contexto.
	measure 'Card Ciclo financeiro' =
			VAR _v = [Ciclo financeiro]
			VAR _valor = IF(ISBLANK(_v), "–", FORMAT(_v, "0", "pt-BR") & " dias")
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>CICLO FINANCEIRO</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>dias de venda bancados pelo caixa</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 6acc87c1-05f4-49ca-ad34-e0f58585cbb2

	/// Cartão HTML (visual HTML Content). Vermelho-claro acima de 3% (o histórico da empresa era ~2%).
	measure 'Card Inadimplência' =
			VAR _v = [% Inadimplência 90+]
			VAR _valor = IF(ISBLANK(_v), "–", FORMAT(_v, "0.0%", "pt-BR"))
			VAR _cor = IF(_v > 0.03, "#F87171", "#FFFFFF")
			VAR _sub = "R$ " & FORMAT([Vencido 90+] / 1000, "#,0", "pt-BR") & " mil vencidos há mais de 90 dias"
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>INADIMPLÊNCIA 90+</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15;color:" & _cor & "'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: ec65722f-4c9a-4f29-9914-d004690b9b1b

	/// Cartão HTML: frete realizado x orçado. Coral acima de 105% do orçamento.
	measure 'Card Logística' =
			VAR _real = -CALCULATE([Resultado], 'Plano de contas'[Grupo DRE] = "Logística")
			VAR _orc = -CALCULATE([Orçado], 'Plano de contas'[Grupo DRE] = "Logística")
			VAR _p = DIVIDE(_real, _orc)
			VAR _valor = IF(ISBLANK(_real), "–", "R$ " & FORMAT(_real / 1000000, "#,0.00", "pt-BR") & " mi")
			VAR _cor = IF(_p > 1.05, "#F87171", "#FFFFFF")
			VAR _sub = FORMAT(_p, "0%", "pt-BR") & " do orçado em fretes"
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>LOGÍSTICA</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15;color:" & _cor & "'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>" & _sub & "</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 41de289c-297b-403c-9ddc-b07682e27e5b

	/// Cartão HTML: meses do período que fecharam com caixa negativo.
	measure 'Card Meses no vermelho' =
			VAR _n = COUNTROWS(FILTER(VALUES('Calendário'[Ano-mês nº]), [Saldo de caixa] < 0)) + 0
			VAR _valor = FORMAT(_n, "0") & IF(_n = 1, " mês", " meses")
			VAR _cor = IF(_n > 0, "#F87171", "#FFFFFF")
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;color:#FFFFFF;height:100%;display:flex;flex-direction:column;justify-content:center;gap:2px'>"
			    & "<div style='font-size:10px;font-weight:600;letter-spacing:.6px;color:#9FB3B8'>MESES NO VERMELHO</div>"
			    & "<div style='font-size:22px;font-weight:700;line-height:1.15;color:" & _cor & "'>" & _valor & "</div>"
			    & "<div style='font-size:10px;color:#9FB3B8'>fechados com saldo de caixa negativo</div></div>"
		displayFolder: Cartões HTML
		lineageTag: 9e390ee0-c6a8-4859-8719-ba2a34e0ba2a

	column x
		isHidden
		lineageTag: 070175e1-43e5-4c97-96cd-4dceda059786
		isNameInferred
		sourceColumn: [x]

	partition _Medidas = calculated
		mode: import
		source = ROW("x", BLANK())

