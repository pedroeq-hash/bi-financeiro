          "properties": {
            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\", \"data\": {\"name\": \"dataset\"}, \"transform\": [{\"filter\": \"indexof([4, 6, 7, 8, 11], datum[''Ordem'']) >= 0\"}, {\"calculate\": \"substring(datum[''Linha''], 4)\", \"as\": \"grupo\"}, {\"calculate\": \"pbiFormat(datum[''Realizado x orçado %''], ''0%'')\", \"as\": \"rotulo\"}, {\"calculate\": \"datum[''Realizado x orçado %''] > 1.05\", \"as\": \"estouro\"}, {\"calculate\": \"(datum[''Valor DRE''] < 0 ? ''−'' : '''') + ''R$ '' + pbiFormat(abs(datum[''Valor DRE'']) / 1000000, ''#,0.00'') + '' mi''\", \"as\": \"real_txt\"}, {\"calculate\": \"(datum[''Orçado DRE''] < 0 ? ''−'' : '''') + ''R$ '' + pbiFormat(abs(datum[''Orçado DRE'']) / 1000000, ''#,0.00'') + '' mi''\", \"as\": \"orc_txt\"}, {\"joinaggregate\": [{\"op\": \"max\", \"field\": \"Realizado x orçado %\", \"as\": \"maximo\"}]}, {\"calculate\": \"max(datum.maximo, 1) * 1.18\", \"as\": \"teto\"}], \"layer\": [{\"mark\": {\"type\": \"rule\", \"opacity\": 0}, \"encoding\": {\"y\": {\"field\": \"grupo\", \"type\": \"nominal\", \"sort\": {\"field\": \"Ordem\", \"op\": \"min\"}, \"title\": null}, \"x\": {\"field\": \"teto\", \"type\": \"quantitative\", \"axis\": null}}}, {\"mark\": {\"type\": \"bar\", \"cornerRadiusEnd\": 3, \"height\": {\"band\": 0.6}}, \"encoding\": {\"y\": {\"field\": \"grupo\", \"type\": \"nominal\", \"sort\": {\"field\": \"Ordem\", \"op\": \"min\"}, \"title\": null}, \"x\": {\"field\": \"Realizado x orçado %\", \"type\": \"quantitative\", \"axis\": null}, \"color\": {\"condition\": {\"test\": \"datum.estouro\", \"value\": \"#F87171\"}, \"value\": \"#5EC4D3\"}, \"tooltip\": [{\"field\": \"grupo\", \"title\": \"Grupo\"}, {\"field\": \"real_txt\", \"title\": \"Realizado\"}, {\"field\": \"orc_txt\", \"title\": \"Orçado\"}, {\"field\": \"rotulo\", \"title\": \"Realizado x orçado\"}]}}, {\"mark\": {\"type\": \"text\", \"align\": \"left\", \"dx\": 5, \"fontSize\": 11, \"fontWeight\": \"bold\"}, \"encoding\": {\"y\": {\"field\": \"grupo\", \"type\": \"nominal\", \"sort\": {\"field\": \"Ordem\", \"op\": \"min\"}, \"title\": null}, \"x\": {\"field\": \"Realizado x orçado %\", \"type\": \"quantitative\", \"axis\": null}, \"text\": {\"field\": \"rotulo\"}, \"color\": {\"condition\": {\"test\": \"datum.estouro\", \"value\": \"#F87171\"}, \"value\": \"#FFFFFF\"}}}, {\"data\": {\"values\": [{\"v\": 1}]}, \"layer\": [{\"mark\": {\"type\": \"rule\", \"strokeDash\": [4, 3], \"color\": \"#9FB3B8\"}, \"encoding\": {\"x\": {\"field\": \"v\", \"type\": \"quantitative\"}}}, {\"mark\": {\"type\": \"text\", \"align\": \"center\", \"baseline\": \"top\", \"y\": {\"expr\": \"height + 4\"}, \"fontSize\": 9, \"color\": \"#9FB3B8\", \"text\": \"orçado\"}, \"encoding\": {\"x\": {\"field\": \"v\", \"type\": \"quantitative\"}}}]}]}'"
