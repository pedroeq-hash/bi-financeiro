{\"mark\": {\"type\": \"text\", \"align\": \"left\", \"baseline\": \"top\", \"x\": 2, \"y\": 2, \"fontSize\": 12, \"fontWeight\": \"bold\", \"color\": \"#9FB3B8\", \"text\": \"LUCRO LÍQUIDO NO ANO\"}}, {\"mark\": {\"type\": \"text\", \"align\": \"left\", \"baseline\": \"top\", \"x\": 2, \"y\": 20, \"fontSize\": 38, \"fontWeight\": \"bold\"}, \"encoding\": {\"text\": {\"field\": \"valor\"}, \"color\": {\"value\": \"#FFFFFF\"}}}, {\"mark\": {\"type\": \"text\", \"align\": \"left\", \"baseline\": \"top\", \"x\": 2, \"y\": 66, \"fontSize\": 12, \"color\": \"#B9CBCF\"}, \"encoding\": {\"text\": {\"field\": \"sub\"}}}]}]}'"
